{
  "name": "thinking-orbs-native",
  "version": "0.1.0",
  "description": "High-performance React Native thinking orb indicators.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/index.ts",
