  },
  "devDependencies": {
    "@shopify/react-native-skia": "^2.11.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-native": "^0.86.2",
    "react-native-reanimated": "^4.5.3",
    "react-native-worklets": "^0.11.3",
    "typescript": "^5.9.3"
  }
