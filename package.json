{
  "name": "thinking-orbs-native",
  "version": "0.1.0",
  "description": "High-performance React Native thinking orb indicators.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "pack:check": "pnpm build && pnpm exec publint && pnpm pack --dry-run",
    "prepublishOnly": "pnpm pack:check",
    "release:check": "pnpm pack:check"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.73.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "^2.11.0",
    "@types/react": "^19.2.18",
    "publint": "^0.3.23",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-reanimated": "^4.5.3",
    "react-native-worklets": "^0.11.3",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  }
}
