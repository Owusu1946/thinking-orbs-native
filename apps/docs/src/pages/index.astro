---
const states = ['working', 'searching', 'solving', 'listening', 'connecting', 'weaving', 'composing', 'breathing', 'shaping'];
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Thinking Orbs for React Native — native-feeling indicators for work in progress." />
    <title>Thinking Orbs · React Native</title>
  </head>
  <body>
    <header class="nav shell"><a class="wordmark" href="/"><span>◌</span> thinking-orbs-native</a><nav><a href="#states">States</a><a href="#install">Install</a><a href="https://github.com/mhaadi/thinking-orbs-native">GitHub ↗</a></nav></header>
    <main>
      <section class="hero shell"><div><p class="eyebrow">native signal / 0.1</p><h1>Make the waiting<br /><em>feel intentional.</em></h1><p class="lede">Nine monochrome thinking states for React Native. Skia drawing, Reanimated motion, and a small footprint that stays out of the way.</p><a class="button" href="#install">Install the orb</a></div><div class="hero-orb"><div class="orb orb-xl">{Array.from({ length: 11 }).map(() => <i></i>)}</div><small>working / 64</small></div></section>
      <section class="signal shell"><span>UI-thread animation</span><span>Skia renderer</span><span>Expo Go friendly</span><span>MIT licensed</span></section>
      <section id="states" class="states shell"><p class="eyebrow">the vocabulary</p><h2>Choose a signal<br /><em>that says something.</em></h2><div class="state-grid">{states.map((state, index) => <article><div class={`orb orb-${index % 3 === 0 ? 'md' : index % 3 === 1 ? 'sm' : 'lg'}`}>{Array.from({ length: 10 }).map(() => <i></i>)}</div><div><h3>{state}</h3><p>{['Work in flight', 'Looking something up', 'Finding an answer', 'Taking input', 'Opening a path', 'Connecting ideas', 'Writing a reply', 'Quietly thinking', 'Forming a structure'][index]}</p></div></article>)}</div></section>
      <section id="install" class="install shell"><div><p class="eyebrow">start here</p><h2>One component.<br /><em>Clear intent.</em></h2></div><div class="code-card"><p>Install the package and native peers.</p><pre><code>pnpm add @mhaadi/thinking-orbs-native
pnpm add @shopify/react-native-skia react-native-reanimated react-native-worklets</code></pre><pre><code>import &#123; ThinkingOrb &#125; from '@mhaadi/thinking-orbs-native';

&lt;ThinkingOrb state="searching" size=&#123;20&#125; /&gt;</code></pre></div></section>
    </main>
    <footer class="shell footer"><span>thinking-orbs-native</span><span>Made for the in-between.</span><a href="https://www.npmjs.com/package/@mhaadi/thinking-orbs-native">npm ↗</a></footer>
  </body>
</html>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#f4f3ef;color:#181817;font-family:Manrope,sans-serif}.shell{width:min(1120px,calc(100% - 48px));margin:auto}.nav{height:78px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d9d7d0}.wordmark,nav a,.footer,.eyebrow,.signal,article p{font-family:'DM Mono',monospace}.wordmark{color:#181817;text-decoration:none;font-size:13px}.wordmark span{font-size:22px;margin-right:8px}nav{display:flex;gap:24px}nav a{color:#6c6b65;text-decoration:none;font-size:11px}.hero{min-height:610px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:60px}.eyebrow{color:#8a887f;text-transform:uppercase;letter-spacing:.12em;font-size:10px}h1,h2{margin:0;font-weight:700;letter-spacing:-.075em;line-height:.96}h1{font-size:clamp(54px,8vw,92px)}h2{font-size:clamp(40px,5vw,64px)}em{font-family:Georgia,serif;font-weight:400}.lede{width:min(430px,100%);margin:28px 0 32px;color:#6c6b65;font-size:16px;line-height:1.65}.button{display:inline-block;padding:13px 18px;border-radius:99px;background:#181817;color:#f4f3ef;text-decoration:none;font:12px 'DM Mono',monospace}.hero-orb{display:grid;place-items:center;gap:20px}.hero-orb small{color:#8a887f;font:10px 'DM Mono',monospace}.orb{position:relative;border-radius:50%}.orb-xl{width:270px;height:270px}.orb-lg{width:82px;height:82px}.orb-md{width:54px;height:54px}.orb-sm{width:34px;height:34px}.orb i{position:absolute;display:block;width:7px;height:7px;margin:-3.5px;border-radius:50%;background:#282825;animation:drift 3.4s ease-in-out infinite}.orb-xl i{width:12px;height:12px;margin:-6px}.orb-sm i{width:5px;height:5px;margin:-2.5px}.orb i:nth-child(1){left:50%;top:7%}.orb i:nth-child(2){left:78%;top:18%;animation-delay:-.7s}.orb i:nth-child(3){left:94%;top:48%;animation-delay:-1.1s}.orb i:nth-child(4){left:77%;top:79%;animation-delay:-1.6s}.orb i:nth-child(5){left:50%;top:93%;animation-delay:-2.2s}.orb i:nth-child(6){left:21%;top:79%;animation-delay:-2.7s}.orb i:nth-child(7){left:6%;top:49%;animation-delay:-3.1s}.orb i:nth-child(8){left:22%;top:18%;animation-delay:-3.4s}.orb i:nth-child(9){left:50%;top:28%;animation-delay:-1.8s}.orb i:nth-child(10){left:72%;top:50%;animation-delay:-.9s}.orb i:nth-child(11){left:50%;top:73%;animation-delay:-2.9s}.signal{border-top:1px solid #d9d7d0;border-bottom:1px solid #d9d7d0;padding:16px 0;display:flex;justify-content:space-between;gap:20px;color:#8a887f;font-size:10px;text-transform:uppercase}.states{padding:150px 0}.state-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:54px;border-top:1px solid #d9d7d0;border-left:1px solid #d9d7d0}.state-grid article{min-height:188px;padding:28px;border-right:1px solid #d9d7d0;border-bottom:1px solid #d9d7d0;display:flex;flex-direction:column;justify-content:space-between}.state-grid h3{margin:0 0 5px;font-size:17px}.state-grid p{margin:0;color:#8a887f;font-size:10px}.install{padding:0 0 150px;display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.code-card{padding:26px;border:1px solid #d0cec6;background:#ebe9e2}.code-card p{color:#8a887f;font:11px 'DM Mono',monospace}pre{padding:17px;overflow:auto;background:#21211f;color:#e7e5dc;font:12px/1.7 'DM Mono',monospace}.footer{border-top:1px solid #d9d7d0;padding:22px 0 32px;display:flex;justify-content:space-between;color:#8a887f;font:10px 'DM Mono',monospace}.footer a{color:#181817;text-decoration:none}@keyframes drift{0%,100%{transform:translate(0,0) scale(.75);opacity:.35}50%{transform:translate(3px,-4px) scale(1.25);opacity:1}}@media(max-width:720px){.shell{width:min(100% - 32px,560px)}nav a:not(:last-child){display:none}.hero{min-height:570px;grid-template-columns:1fr;gap:40px;padding:70px 0}.hero-orb{order:-1}.orb-xl{width:190px;height:190px}.signal{flex-wrap:wrap;justify-content:flex-start}.states{padding:100px 0}.state-grid{grid-template-columns:repeat(2,1fr)}.state-grid article{min-height:160px;padding:18px}.install{grid-template-columns:1fr;gap:36px;padding-bottom:100px}.footer{gap:14px;flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){.orb i{animation:none}}
</style>
