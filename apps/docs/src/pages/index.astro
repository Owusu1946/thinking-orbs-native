---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrbCanvas from "../components/OrbCanvas.astro";
import { ThemeToggle } from "../components/ui/theme-toggle";
import type { OrbState } from "../../../../src/types";

const states: Array<{ state: OrbState; label: string; note: string; large?: boolean }> = [
  { state: "working", label: "Working…", note: "general work in flight", large: true },
  { state: "searching", label: "Searching…", note: "looking something up", large: true },
  { state: "solving", label: "Solving…", note: "working through a problem" },
  { state: "listening", label: "Listening…", note: "receiving input" },
  { state: "connecting", label: "Connecting…", note: "opening a connection" },
  { state: "weaving", label: "Weaving…", note: "combining ideas" },
  { state: "composing", label: "Composing…", note: "writing a response" },
  { state: "breathing", label: "Thinking…", note: "quiet neutral thought" },
  { state: "shaping", label: "Shaping…", note: "forming a structure" },
];

const installCommand = "pnpm add @mhaadi/thinking-orbs-native @shopify/react-native-skia react-native-reanimated react-native-worklets";
const usageSnippet = `import { ThinkingOrb } from '@mhaadi/thinking-orbs-native';

<ThinkingOrb state="searching" size={64} />`;
---

<BaseLayout
  title="Thinking Orbs · React Native"
  description="Nine animated thinking states, rendered natively with Skia and Reanimated."
>
  <div class="landing-page">
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="Thinking Orbs home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span>thinking-orbs-native</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#states">states</a>
        <a href="#install">install</a>
        <a href="/overview">docs</a>
        <a href="https://github.com/Jakubantalik/thinking-orbs" target="_blank" rel="noopener">github ↗</a>
        <ThemeToggle class="landing-theme-toggle" />
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <p class="kicker"><span></span> React Native / Skia / Reanimated</p>
          <h1>Thinking states<br />that feel <em>native.</em></h1>
          <p class="hero-lede">
            Nine animated indicators for the moments between a request and a result.
            Faithful to the open-source Thinking Orbs family, rebuilt for the native UI thread.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#install">install package</a>
            <a class="button button-secondary" href="/overview">read the docs <span>↗</span></a>
          </div>
        </div>

        <div class="hero-stage" aria-label="Animated composing state preview">
          <div class="stage-grid" aria-hidden="true"></div>
          <div class="hero-pill">
            <OrbCanvas state="composing" size={64} displaySize={82} />
            <span class="shimmer" data-text="Thinking…">Thinking…</span>
          </div>
          <div class="stage-readout">
            <span><i></i> live</span>
            <span>state / composing</span>
            <span>64px</span>
          </div>
        </div>
      </section>

      <div class="signal-bar">
        <div class="shell signal-track">
          <span>UI-thread animation</span>
          <span>Skia renderer</span>
          <span>20 + 64px profiles</span>
          <span>reduced-motion aware</span>
          <span>MIT licensed</span>
        </div>
      </div>

      <section id="states" class="states-section shell">
        <div class="section-heading">
          <div>
            <p class="kicker"><span></span> the full vocabulary</p>
            <h2>Nine states.<br /><em>One visual language.</em></h2>
          </div>
          <p>Use motion as information. Each preset describes a different kind of work without adding another status message.</p>
        </div>

        <div class="state-grid">
          {states.map(({ state, label, note, large }, index) => (
            <article class:list={["state-card", large && "state-card-large"]} data-state={state}>
              <div class="state-index">{String(index + 1).padStart(2, "0")}</div>
              <div class="state-preview">
                <div class:list={["message-pill", !large && "message-pill-small"]}>
                  <OrbCanvas state={state} size={large ? 64 : 20} displaySize={large ? 56 : 20} />
                  <span class="shimmer" data-text={label}>{label}</span>
                </div>
              </div>
              <div class="state-meta">
                <h3>{state}</h3>
                <p>{note}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="install" class="install-section">
        <div class="shell install-grid">
          <div class="install-copy">
            <p class="kicker"><span></span> package / v0.1</p>
            <h2>Drop it into<br /><em>the in-between.</em></h2>
            <p>
              The public API stays small. Choose a state and density profile; theme,
              pausing, reduced motion, and accessibility are already accounted for.
            </p>
            <a href="/api">explore the complete API <span>↗</span></a>
          </div>

          <div class="code-stack">
            <div class="code-block">
              <div class="code-label"><span>01</span> install package <button data-copy={installCommand}>copy</button></div>
              <pre><code>{installCommand}</code></pre>
            </div>
            <div class="code-block">
              <div class="code-label"><span>02</span> render a state <button data-copy={usageSnippet}>copy</button></div>
              <pre><code>{usageSnippet}</code></pre>
            </div>
          </div>
        </div>
      </section>

      <section class="playground-section shell" aria-label="Interactive playground">
        <div class="playground-head">
          <div>
            <p class="kicker"><span></span> live specimen</p>
            <h2>Playground</h2>
          </div>
          <p>Same presets. Same engine. Select a state and inspect it at native density.</p>
        </div>

        <div class="playground" data-playground>
          <div class="controls">
            <div class="control-group">
              <span class="control-label">state</span>
              <div class="state-tabs" role="radiogroup" aria-label="Orb state">
                {states.map(({ state }) => <button class:list={[state === "listening" && "active"]} data-state-option={state}>{state}</button>)}
              </div>
            </div>
            <div class="control-row">
              <div class="control-group">
                <span class="control-label">size</span>
                <div class="size-tabs">
                  <button class="active" data-size-option="64">64px</button>
                  <button data-size-option="20">20px</button>
                </div>
              </div>
              <button class="pause-button" data-pause aria-pressed="false"><span>Ⅱ</span> pause</button>
            </div>
          </div>
          <div class="playground-preview">
            <div class="preview-crosshair" aria-hidden="true"></div>
            <OrbCanvas state="listening" size={64} displaySize={128} class="playground-orb" />
            <p data-preview-label>listening / 64</p>
          </div>
          <div class="playground-code">
            <span>tsx</span>
            <code data-snippet>&lt;ThinkingOrb state="listening" size=&#123;64&#125; /&gt;</code>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>thinking-orbs-native</span></a>
      <p>A native port of <a href="https://github.com/Jakubantalik/thinking-orbs" target="_blank" rel="noopener">Thinking Orbs ↗</a></p>
      <div><a href="https://www.npmjs.com/package/@mhaadi/thinking-orbs-native" target="_blank" rel="noopener">npm ↗</a><a href="https://github.com/mhaadiabu/thinking-orbs-native" target="_blank" rel="noopener">source ↗</a></div>
    </footer>
  </div>

  <script>
    const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-copy]");
    copyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "copied";
        window.setTimeout(() => { button.textContent = "copy"; }, 1200);
      });
    });

    const playground = document.querySelector<HTMLElement>("[data-playground]");
    if (playground) {
      const canvas = playground.querySelector<HTMLCanvasElement>("[data-orb-canvas]");
      const label = playground.querySelector<HTMLElement>("[data-preview-label]");
      const snippet = playground.querySelector<HTMLElement>("[data-snippet]");
      const pause = playground.querySelector<HTMLButtonElement>("[data-pause]");
      let state = "listening";
      let size = 64;
      let paused = false;

      const update = () => {
        if (canvas) {
          canvas.dataset.state = state;
          canvas.dataset.orbSize = String(size);
          canvas.dataset.displaySize = size === 64 ? "128" : "60";
        }
        if (label) label.textContent = `${state} / ${size}`;
        if (snippet) snippet.textContent = `<ThinkingOrb state="${state}" size={${size}} />`;
      };

      playground.querySelectorAll<HTMLButtonElement>("[data-state-option]").forEach((button) => {
        button.addEventListener("click", () => {
          state = button.dataset.stateOption ?? state;
          playground.querySelectorAll("[data-state-option]").forEach((item) => item.classList.remove("active"));
          button.classList.add("active");
          update();
        });
      });

      playground.querySelectorAll<HTMLButtonElement>("[data-size-option]").forEach((button) => {
        button.addEventListener("click", () => {
          size = Number(button.dataset.sizeOption ?? size);
          playground.querySelectorAll("[data-size-option]").forEach((item) => item.classList.remove("active"));
          button.classList.add("active");
          update();
        });
      });

      pause?.addEventListener("click", () => {
        paused = !paused;
        if (canvas) canvas.dataset.paused = String(paused);
        pause.classList.toggle("active", paused);
        pause.setAttribute("aria-pressed", String(paused));
        pause.innerHTML = paused ? "<span>▶</span> play" : "<span>Ⅱ</span> pause";
      });
    }
  </script>
</BaseLayout>

<style>
  .landing-page{--acid:#b9ff4b;--page:#090909;--panel:#101010;--panel-2:#141414;--ink:#ededed;--muted:#777;--line:#232323;min-height:100vh;background:var(--page);color:var(--ink);font-family:var(--nb-font-mono)}
  :global(html:not([data-mode="dark"])) .landing-page{--page:#f7f7f5;--panel:#fff;--panel-2:#efefec;--ink:#171717;--muted:#74746e;--line:#d9d9d4;--acid:#5b8f00}
  .shell{width:min(1160px,calc(100% - 48px));margin-inline:auto}.site-header{height:68px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
  .brand{display:flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none;font-size:12px;letter-spacing:-.02em}.brand-mark{position:relative;width:20px;height:20px;display:block}.brand-mark i{position:absolute;width:4px;height:4px;border-radius:50%;background:currentColor}.brand-mark i:nth-child(1){left:8px;top:1px}.brand-mark i:nth-child(2){right:1px;top:8px}.brand-mark i:nth-child(3){left:8px;bottom:1px}.brand-mark i:nth-child(4){left:1px;top:8px}.site-header nav{display:flex;align-items:center;gap:24px}.site-header nav a{color:var(--muted);font-size:10px;text-decoration:none;text-transform:uppercase;letter-spacing:.08em;transition:color .2s}.site-header nav a:hover{color:var(--acid)}
  :global(.landing-theme-toggle){width:30px!important;height:30px!important;border:1px solid var(--line)!important;border-radius:50%!important;color:var(--muted)!important}
  .hero{min-height:680px;display:grid;grid-template-columns:1fr .88fr;gap:72px;align-items:center;padding-block:80px}.kicker{display:flex;align-items:center;gap:10px;margin:0 0 22px;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.14em}.kicker span{display:block;width:4px;height:4px;background:var(--acid)}
  h1,h2{margin:0;color:var(--ink);font-family:var(--nb-font-mono);font-weight:500;letter-spacing:-.07em;line-height:.94}h1{font-size:clamp(52px,6.4vw,86px)}h2{font-size:clamp(40px,5vw,68px)}h1 em,h2 em{color:var(--muted);font:inherit;font-weight:300}.hero-lede{max-width:610px;margin:30px 0;color:var(--muted);font-size:13px;line-height:1.8}.hero-actions{display:flex;gap:10px}.button{padding:12px 16px;border:1px solid var(--line);font-size:11px;text-decoration:none;transition:.2s}.button-primary{background:var(--acid);border-color:var(--acid);color:#0b0b0b}.button-primary:hover{filter:brightness(.9)}.button-secondary{color:var(--muted)}.button-secondary:hover{border-color:var(--acid);color:var(--acid)}
  .hero-stage{position:relative;min-height:486px;border:1px solid var(--line);background:var(--panel);display:grid;place-items:center;overflow:hidden}.stage-grid{position:absolute;inset:0;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,transparent,black 18%,black 82%,transparent);opacity:.5}.hero-pill{position:relative;display:flex;align-items:center;gap:17px;width:304px;height:88px;padding:3px 30px 3px 7px;border:1px solid color-mix(in srgb,var(--ink) 12%,transparent);border-radius:999px;background:color-mix(in srgb,var(--ink) 5%,var(--panel));box-shadow:inset 0 0 50px color-mix(in srgb,var(--ink) 2%,transparent);font-size:18px}.stage-readout{position:absolute;left:18px;right:18px;bottom:16px;display:flex;justify-content:space-between;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.08em}.stage-readout span:first-child{color:var(--acid)}.stage-readout i{display:inline-block;width:4px;height:4px;margin-right:5px;background:var(--acid);animation:pulse 1.5s infinite}
  .shimmer{position:relative;color:color-mix(in srgb,var(--ink) 45%,transparent)}.shimmer::before{content:attr(data-text);position:absolute;inset:0;background:linear-gradient(90deg,transparent 35%,var(--ink) 50%,transparent 65%);background-size:400% 100%;background-clip:text;color:transparent;animation:shimmer 2.2s linear infinite}
  .signal-bar{border-block:1px solid var(--line);background:var(--panel)}.signal-track{height:48px;display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.12em}.signal-track span{display:flex;align-items:center;gap:10px}.signal-track span::before{content:"";width:3px;height:3px;background:var(--acid);opacity:.6}
  .states-section{padding-block:150px}.section-heading{display:grid;grid-template-columns:1fr 360px;align-items:end;gap:60px;margin-bottom:56px}.section-heading>p{margin:0;color:var(--muted);font-size:12px;line-height:1.8}.state-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.state-card{position:relative;min-height:280px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--page);display:flex;flex-direction:column;transition:background .2s}.state-card:hover{background:var(--panel)}.state-card-large{grid-column:span 1;min-height:360px}.state-index{position:absolute;top:15px;right:16px;color:var(--muted);font-size:9px}.state-preview{flex:1;display:grid;place-items:center;padding:48px 24px 24px}.message-pill{display:flex;align-items:center;gap:12px;height:68px;padding:6px 22px 6px 6px;border-radius:99px;border:1px solid var(--line);background:var(--panel-2);font-size:14px}.message-pill-small{height:38px;padding:4px 13px 4px 8px;gap:9px;font-size:10px}.state-meta{display:flex;justify-content:space-between;align-items:end;gap:16px;padding:18px;border-top:1px solid var(--line)}.state-meta h3{margin:0;color:var(--ink);font-size:12px;font-weight:500}.state-meta p{margin:0;color:var(--muted);font-size:9px;text-align:right}
  .install-section{padding-block:130px;border-block:1px solid var(--line);background:var(--panel)}.install-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:100px;align-items:start}.install-copy>p:not(.kicker){max-width:420px;margin:30px 0;color:var(--muted);font-size:12px;line-height:1.8}.install-copy>a{color:var(--acid);font-size:10px;text-decoration:none}.code-stack{display:flex;flex-direction:column;gap:12px}.code-block{border:1px solid var(--line);background:var(--page)}.code-label{display:flex;align-items:center;gap:12px;height:42px;padding:0 14px;border-bottom:1px solid var(--line);color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.1em}.code-label span{color:var(--acid)}.code-label button{margin-left:auto;border:0;background:none;color:var(--muted);font:inherit;cursor:pointer}.code-label button:hover{color:var(--acid)}.code-block pre{margin:0;padding:22px;overflow:auto;background:transparent;color:var(--ink);font:11px/1.8 var(--nb-font-mono);white-space:pre-wrap;overflow-wrap:anywhere}
  .playground-section{padding-block:140px}.playground-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:40px}.playground-head>p{max-width:380px;margin:0;color:var(--muted);font-size:11px;line-height:1.7}.playground{display:grid;grid-template-columns:340px 1fr;border:1px solid var(--line);background:var(--panel)}.controls{padding:24px;border-right:1px solid var(--line)}.control-group{display:flex;flex-direction:column;gap:10px;margin-bottom:24px}.control-label{color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.12em}.state-tabs{display:grid;grid-template-columns:repeat(2,1fr);gap:5px}.state-tabs button,.size-tabs button,.pause-button{height:34px;border:1px solid var(--line);background:var(--page);color:var(--muted);font:9px var(--nb-font-mono);cursor:pointer;transition:.15s}.state-tabs button:hover,.size-tabs button:hover,.pause-button:hover{color:var(--ink);border-color:var(--muted)}.state-tabs button.active,.size-tabs button.active,.pause-button.active{border-color:color-mix(in srgb,var(--acid) 50%,var(--line));background:color-mix(in srgb,var(--acid) 8%,var(--page));color:var(--acid)}.control-row{display:flex;align-items:end;justify-content:space-between;gap:16px}.control-row .control-group{margin:0}.size-tabs{display:flex;gap:5px}.size-tabs button{width:60px}.pause-button{width:78px}.pause-button span{margin-right:5px}.playground-preview{position:relative;min-height:400px;display:grid;place-items:center;background:var(--page);overflow:hidden}.preview-crosshair::before,.preview-crosshair::after{content:"";position:absolute;background:var(--line)}.preview-crosshair::before{width:1px;height:100%;left:50%;top:0}.preview-crosshair::after{height:1px;width:100%;left:0;top:50%}.playground-preview>p{position:absolute;right:14px;bottom:12px;margin:0;color:var(--muted);font-size:9px}.playground-orb{position:relative;z-index:1}.playground-code{grid-column:1/-1;display:flex;align-items:center;gap:18px;min-height:52px;padding:10px 16px;border-top:1px solid var(--line);color:var(--ink);font-size:10px}.playground-code>span{color:var(--acid);text-transform:uppercase}.playground-code code{overflow:auto}
  .site-footer{min-height:110px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:9px}.site-footer p{margin:0}.site-footer a{color:inherit;text-decoration:none}.site-footer a:hover{color:var(--acid)}.site-footer>div{display:flex;gap:20px}
  @keyframes shimmer{to{background-position:-100% 0}}@keyframes pulse{50%{opacity:.25}}
  @media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto}.hero-stage{min-height:430px}.section-heading,.install-grid{grid-template-columns:1fr;gap:36px}.state-grid{grid-template-columns:repeat(2,1fr)}.install-grid{gap:50px}.playground{grid-template-columns:280px 1fr}}
  @media(max-width:680px){.shell{width:min(100% - 28px,560px)}.site-header{height:58px}.site-header nav{gap:12px}.site-header nav a:nth-child(-n+2){display:none}.hero{padding-block:64px;gap:48px}.hero-stage{min-height:330px}.hero-pill{width:250px;height:76px;font-size:14px}.signal-track{justify-content:flex-start;gap:24px;overflow:auto}.signal-track span:nth-child(n+4){display:none}.states-section,.playground-section{padding-block:96px}.state-grid{grid-template-columns:1fr}.state-card,.state-card-large{min-height:250px}.install-section{padding-block:90px}.playground-head{display:block}.playground-head>p{margin-top:20px}.playground{grid-template-columns:1fr}.controls{border-right:0;border-bottom:1px solid var(--line)}.playground-preview{min-height:320px}.site-footer{padding-block:28px;gap:20px;flex-wrap:wrap}.site-footer p{order:3;width:100%}}
  @media(prefers-reduced-motion:reduce){.shimmer::before,.stage-readout i{animation:none}}
</style>
